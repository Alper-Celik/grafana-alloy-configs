declare "systemd_journal" {
	argument "host" { }

	argument "arch" { }

	argument "forward_to" { }

	loki.relabel "labels" {
		forward_to = argument.forward_to.value

		rule {
			target_label = "host"
			replacement  = argument.host.value
		}

		rule {
			target_label = "arch"
			replacement  = argument.arch.value
		}

		rule {
			source_labels = ["__journal__systemd_unit"]
			target_label  = "unit"
			regex         = "(.*)"
			replacement   = "$1"
		}

		rule {
			source_labels = ["__journal__syslog_identifier"]
			target_label  = "syslog_id"
		}

rule {
    action = "labelmap"
    regex  = "__journal__(.*)"
    replacement = "debug_$1"
}
	}

	loki.source.journal "system" {
		forward_to = [loki.relabel.labels.receiver]
		max_age    = "168h"
	}
}
